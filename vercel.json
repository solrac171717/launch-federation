{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/compare/index.html",
      "destination": "/compare/",
      "permanent": true
    },
    {
      "source": "/compare/owned-map-vs-kubera(.html)?",
      "destination": "/compare/kubera-vs-owned-map",
      "permanent": true
    },
    {
      "source": "/compare/:slug.html",
      "destination": "/compare/:slug",
      "permanent": true
    },
    {
      "source": "/solutions/:slug.html",
      "destination": "/solutions/:slug",
      "permanent": true
    },
    {
      "source": "/guides/:slug.html",
      "destination": "/guides/:slug",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.ownedmap.com"
        }
      ],
      "destination": "https://ownedmap.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/compare/:slug",
      "destination": "/compare/:slug.html"
    },
    {
      "source": "/solutions/:slug",
      "destination": "/solutions/:slug.html"
    },
    {
      "source": "/guides/:slug",
      "destination": "/guides/:slug.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(welcome|share).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/tick.js": {
      "maxDuration": 60
    },
    "api/linkedin.js": {
      "maxDuration": 60
    }
  }
}
