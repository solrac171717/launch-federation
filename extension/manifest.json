{
  "manifest_version": 3,
  "name": "Owned Map for LinkedIn",
  "version": "0.1.0",
  "description": "Sends the LinkedIn posts and profiles you are looking at to your Owned Map account, to be scored. It never sends a message, an invitation or a click for you.",
  "permissions": ["storage"],
  "host_permissions": ["https://ownedmap.com/*", "https://www.linkedin.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Owned Map", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://www.linkedin.com/feed/*", "https://www.linkedin.com/search/results/content/*", "https://www.linkedin.com/posts/*"], "js": ["lib.js", "content-posts.js"], "run_at": "document_idle" },
    { "matches": ["https://www.linkedin.com/in/*"], "js": ["lib.js", "content-profile.js"], "run_at": "document_idle" }
  ]
}
