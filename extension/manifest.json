{
  "manifest_version": 3,
  "name": "Owned Map for LinkedIn",
  "version": "0.2.0",
  "description": "Reads the LinkedIn posts you look at, and only for the leads you queue in the app fills in your invitation or message and, if you turn it on, sends it from your own browser, a few per day. Your LinkedIn login never leaves your browser.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://ownedmap.com/*",
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Owned Map",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/feed/*",
        "https://www.linkedin.com/search/results/content/*",
        "https://www.linkedin.com/posts/*"
      ],
      "js": [
        "lib.js",
        "content-posts.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/in/*"
      ],
      "js": [
        "lib.js",
        "content-profile.js",
        "content-outreach.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ownedmap.com/app*",
        "https://www.ownedmap.com/app*"
      ],
      "js": [
        "content-app.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
